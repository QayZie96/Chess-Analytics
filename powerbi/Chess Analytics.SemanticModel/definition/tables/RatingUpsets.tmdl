		lineageTag: 2da31cf3-dcfb-487f-a3f0-98382a66ed21
		summarizeBy: none
		sourceColumn: lower_rated_player_band

		annotation SummarizationSetBy = Automatic

	column eligible_games
		dataType: int64
		formatString: 0
		lineageTag: 2609423b-af70-43bf-ac17-02ad7a9b9602
		summarizeBy: sum
		sourceColumn: eligible_games

		annotation SummarizationSetBy = Automatic

	column upset_games
		dataType: int64
		formatString: 0
		lineageTag: b8499ff3-7b95-4e66-b335-ea7e9a03370d
		summarizeBy: sum
		sourceColumn: upset_games

		annotation SummarizationSetBy = Automatic

	partition RatingUpsets = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("E:\Chess-Analytics\data\exports\powerbi\rating_upsets_powerbi.csv"),[Delimiter=",", Columns=5, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"speed_category", type text}, {"rating_gap_band", type text}, {"lower_rated_player_band", type text}, {"eligible_games", Int64.Type}, {"upset_games", Int64.Type}})
				in
				    #"Changed Type"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

