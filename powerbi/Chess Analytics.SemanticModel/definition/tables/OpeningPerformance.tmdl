table OpeningPerformance
	lineageTag: 6c986a28-b079-474d-98e5-978ca7e9b7ac

	measure 'Player-Side Games' = SUM(OpeningPerformance[games])
		formatString: #,0
		lineageTag: 9bba6ff7-d331-4776-bec8-fc8ae57a92f4

	measure 'Opening Wins' = SUM(OpeningPerformance[wins])
		formatString: #,0
		lineageTag: 02734a56-46b6-48d1-826a-7a84c3047f7f

	measure 'Opening Draws' = SUM(OpeningPerformance[draws])
		formatString: #,0
		lineageTag: e381227e-2997-479c-aecd-c63b9e42f2b4

	measure 'Opening Losses' = SUM(OpeningPerformance[losses])
		formatString: #,0
		lineageTag: ad7a7939-c040-4a49-9d05-d142f51fb276

	measure 'Opening Win Rate' = DIVIDE([Opening Wins], [Player-Side Games])
		formatString: 0.00%
		lineageTag: 1ea970e7-7992-48f9-b56f-39ed46a1a5ea

	measure 'Opening Draw Rate' = DIVIDE([Opening Draws], [Player-Side Games])
		formatString: 0.00%
		lineageTag: 0232e2a0-5b05-47b3-a421-c7f465b73486

	measure 'Opening Loss Rate' = DIVIDE([Opening Losses], [Player-Side Games])
		formatString: 0.00%
		lineageTag: 0d941327-1fd5-480a-9121-28fdd40cb6bb

	measure 'Opening Sample Eligible' = IF([Player-Side Games] >= 100, 1, 0)
		formatString: 0
		lineageTag: 8c27a7ba-ab8a-40ec-ad79-07d1da8b8ce1

