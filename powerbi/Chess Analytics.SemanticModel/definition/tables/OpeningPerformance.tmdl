	partition OpeningPerformance = m
		mode: import
		source =
				let
				    CsvSource = Csv.Document(File.Contents("E:\Chess-Analytics\data\exports\powerbi\opening_performance_powerbi.csv"),[Delimiter=",", Columns=9, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    PromotedHeaders = Table.PromoteHeaders(CsvSource, [PromoteAllScalars=true]),
				    TypedColumns = Table.TransformColumnTypes(PromotedHeaders,{{"opening_name", type text}, {"eco_code", type text}, {"rating_band", type text}, {"player_color", type text}, {"speed_category", type text}, {"games", Int64.Type}, {"wins", Int64.Type}, {"draws", Int64.Type}, {"losses", Int64.Type}})
				in
				    TypedColumns

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

